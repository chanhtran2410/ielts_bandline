# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings -> API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — used only by server route handlers (/api/writing/analyze, /api/coach).
# Never expose this to the browser.
ANTHROPIC_API_KEY=

# Data source: "mock" runs entirely on bundled fixtures (no Supabase needed),
# "supabase" reads from your Supabase project.
NEXT_PUBLIC_DATA_SOURCE=mock
